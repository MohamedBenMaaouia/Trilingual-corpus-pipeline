# Copy to .env (gitignored) and replace every change-me value.
# docker compose reads .env automatically; corpus.config reads the CORPUS_* variables.
# Every variable a service or corpus.config reads is listed here, and nothing else.

# Execution profile: local (Docker: MinIO + standalone Spark) | azure (Sprint 10)
CORPUS_ENV=local

# MinIO root account (minio service). Password: at least 8 characters.
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-too

# Postgres superuser (postgres service): owns the airflow and corpus databases.
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me-too
