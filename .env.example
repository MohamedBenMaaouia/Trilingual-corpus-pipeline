# Copy to .env (gitignored) and replace every change-me value.
# docker compose reads .env automatically; corpus.config reads the CORPUS_* variables.
# Every variable a service or corpus.config reads is listed here, and nothing else.

# Execution profile: local (Docker: MinIO + standalone Spark) | azure (Sprint 10)
CORPUS_ENV=local

# MinIO root account (minio service). Password: at least 8 characters.
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-too

# MinIO service user for Spark (S3A) and the pipeline, created by minio-init.
# Must differ from the root user. Secret key: at least 8 characters.
CORPUS_S3_ACCESS_KEY=change-me
CORPUS_S3_SECRET_KEY=change-me-too

# Postgres superuser (postgres service): owns the airflow and corpus databases.
# Used inside connection URLs: letters, digits and . _ ~ - only.
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me-too

# Airflow shared secrets: every Airflow container must get the same values.
# JWT secret: signs the tokens tasks use to talk to the api-server (any long random string).
# Fernet key: encrypts connection passwords in Airflow's db. Generate one with:
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_JWT_SECRET=change-me
AIRFLOW_FERNET_KEY=change-me
